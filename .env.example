# Copy to `.env` for local overrides. Development works with these defaults.

# Rails server port. Change when running multiple worktrees.
PORT=3000

# Rspack dev-server port used by Shakapacker.
SHAKAPACKER_DEV_SERVER_PORT=3035

# React on Rails Pro Node renderer port.
RENDERER_PORT=3800

# Development normally reads config/database.yml. Set DATABASE_URL in CI or prod.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/react_on_rails_starter_tanstack_development

# Required in production when encrypted credentials are used. Never commit the real value.
# RAILS_MASTER_KEY=replace-me

# SolidQueue can run in Puma for tiny deploys, but the template defaults to a worker process.
SOLID_QUEUE_IN_PUMA=false

# Uncomment after enabling Sentry in config/initializers/sentry.rb.
# SENTRY_DSN=

# SMTP mail provider example. Development uses local previews until a provider is configured.
# SMTP_ADDRESS=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_DOMAIN=example.com
# SMTP_USERNAME=replace-me
# SMTP_PASSWORD=replace-me

# Alternative provider placeholders for adopter docs.
# MAILGUN_API_KEY=
# POSTMARK_API_TOKEN=
# RESEND_API_KEY=
