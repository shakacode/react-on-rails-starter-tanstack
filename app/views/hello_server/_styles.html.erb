<%# Shared styles for the React Server Components demo (streaming and fallback views). %>
<style>
  :root {
    color-scheme: light;
    --page-bg: #f5efe5;
    --hero-bg: linear-gradient(135deg, #0d3b66 0%, #165a72 48%, #ef8354 100%);
    --panel-bg: rgba(255, 252, 246, 0.94);
    --ink: #112031;
    --muted: #4d5b6a;
    --line: rgba(17, 32, 49, 0.12);
    --shadow: 0 20px 54px rgba(17, 32, 49, 0.14);
  }

  body {
    margin: 0;
    background:
      radial-gradient(circle at top left, rgba(239, 131, 84, 0.22), transparent 34%),
      radial-gradient(circle at bottom right, rgba(13, 59, 102, 0.16), transparent 28%),
      var(--page-bg);
    color: var(--ink);
    font-family: "Avenir Next", Avenir, "Segoe UI", sans-serif;
  }

  .ror-demo-page {
    max-width: 1120px;
    margin: 0 auto;
    padding: 32px 20px 64px;
  }

  .hero,
  .card,
  .demo-surface,
  .notice {
    border-radius: 28px;
    box-shadow: var(--shadow);
  }

  .hero {
    padding: 32px;
    background: var(--hero-bg);
    color: #fff9f1;
  }

  .eyebrow {
    margin: 0 0 12px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 12px;
    font-weight: 700;
    opacity: 0.8;
  }

  .hero h1 {
    margin: 0;
    font-family: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Georgia, serif;
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1;
  }

  .lead {
    max-width: 760px;
    margin: 18px 0 0;
    font-size: 1.04rem;
    line-height: 1.7;
    color: rgba(255, 249, 241, 0.9);
  }

  .link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .link-row a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 11px 18px;
    border-radius: 999px;
    border: 1px solid rgba(255, 249, 241, 0.24);
    color: inherit;
    text-decoration: none;
    font-weight: 700;
    background: rgba(255, 249, 241, 0.12);
  }

  .demo-surface {
    margin-top: 24px;
    padding: 28px;
    background: var(--panel-bg);
    border: 1px solid var(--line);
  }

  .notice {
    margin-top: 24px;
    padding: 28px;
    background: linear-gradient(180deg, rgba(239, 131, 84, 0.12), var(--panel-bg) 70%);
    border: 1px solid rgba(239, 131, 84, 0.4);
  }

  .notice .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 14px;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(239, 131, 84, 0.16);
    border: 1px solid rgba(239, 131, 84, 0.4);
    color: #8a3b12;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .notice .badge::before {
    content: "";
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #ef8354;
  }

  .notice h2 {
    margin: 0 0 12px;
    font-family: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Georgia, serif;
    font-size: 1.5rem;
  }

  .notice p {
    margin: 0 0 14px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 760px;
  }

  .notice p:last-child {
    margin-bottom: 0;
  }

  .notice a {
    color: #0d3b66;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
    margin-top: 20px;
  }

  .card {
    padding: 24px;
    background: var(--panel-bg);
    border: 1px solid var(--line);
  }

  .card h2 {
    margin-top: 0;
    margin-bottom: 16px;
    font-family: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Georgia, serif;
  }

  .card ul {
    margin: 0;
    padding-left: 20px;
  }

  .card li + li {
    margin-top: 12px;
  }

  .card li {
    line-height: 1.65;
    color: var(--muted);
  }

  code {
    padding: 2px 6px;
    border-radius: 8px;
    background: rgba(17, 32, 49, 0.06);
    color: var(--ink);
    font-size: 0.95em;
  }

  @media (max-width: 900px) {
    .hero,
    .card,
    .demo-surface,
    .notice {
      border-radius: 22px;
    }
  }
</style>
