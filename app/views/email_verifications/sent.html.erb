<main class="auth-page">
  <section class="auth-card auth-card-wide">
    <header class="auth-card-header">
      <h1>Check your email</h1>
      <p>We sent a verification link to <strong><%= @masked_email_address %></strong>.</p>
    </header>

    <div class="auth-card-body">
      <%= tag.div(flash[:alert], class: "auth-alert", aria: { live: "polite" }) if flash[:alert] %>
      <%= tag.div(flash[:notice], class: "auth-notice", aria: { live: "polite" }) if flash[:notice] %>

      <p>The link expires after 24 hours. If it is not in your inbox, check spam or filters for mail from React on Rails Starter.</p>

      <%= form_with url: email_verifications_path, class: "auth-form" do |form| %>
        <%= form.hidden_field :email_address, value: Current.user&.email_address || session[:pending_verification_email] %>
        <%= form.submit(@resend_cooldown_seconds.positive? ? "Resend available in #{@resend_cooldown_seconds}s" : "Resend verification link", class: "auth-button", disabled: @resend_cooldown_seconds.positive?) %>
      <% end %>

      <% if Rails.env.development? %>
        <p><%= link_to "Open the local mail preview", "/letter_opener", class: "auth-link" %></p>
      <% end %>
    </div>

    <footer class="auth-card-footer auth-actions">
      <%= link_to "Change email", new_registration_path, class: "auth-link" %>
      <%= link_to "Sign in", new_session_path, class: "auth-link" %>
    </footer>
  </section>
</main>
