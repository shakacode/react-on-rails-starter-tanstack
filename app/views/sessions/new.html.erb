<main class="auth-page">
  <section class="auth-card">
    <%# REFERENCE PATTERN: form - see AGENTS.md section 4 %>
    <header class="auth-card-header">
      <h1>Sign in</h1>
      <p>Use the account you created for this starter.</p>
    </header>

    <div class="auth-card-body">
      <%= tag.div(flash[:alert], class: "auth-alert", aria: { live: "polite" }) if flash[:alert] %>
      <%= tag.div(flash[:notice], class: "auth-notice", aria: { live: "polite" }) if flash[:notice] %>

      <%= form_with url: session_path, class: "auth-form" do |form| %>
        <div class="auth-field">
          <%= form.label :email_address, "Email", class: "auth-label" %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "auth-input" %>
        </div>

        <div class="auth-field">
          <%= form.label :password, class: "auth-label" %>
          <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "auth-input" %>
        </div>

        <%= form.submit "Sign in", class: "auth-button" %>
      <% end %>
    </div>

    <footer class="auth-card-footer auth-actions">
      <%= link_to "Forgot password?", new_password_path, class: "auth-link" %>
      <%= link_to "Create account", new_registration_path, class: "auth-link" %>
    </footer>
  </section>
</main>
