<% content_for(:title) { "React on Rails × TanStack Starter" } %>
<%# The landing renders its own header (with in-page section nav) and footer inline,
    so opt out of the global site chrome to avoid duplicate header/footer. %>
<% content_for(:no_site_chrome, true) %>
<% content_for :head do %>
  <% social_image = "#{github_repo_url}/raw/#{ApplicationHelper::GITHUB_DEFAULT_BRANCH}/docs/images/rendering-mode-drawer.png" %>
  <meta name="description" content="A Rails 8 + React on Rails Pro starter for React 19 Server Components, TanStack Router, TanStack Query, and TanStack Table without moving the app server out of Rails.">
  <meta property="og:type" content="website">
  <meta property="og:title" content="React on Rails × TanStack Starter">
  <meta property="og:description" content="React Server Components on Rails, with TanStack Router where client app state belongs. A clean Rails + React on Rails Pro reference starter.">
  <meta property="og:image" content="<%= social_image %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="React on Rails × TanStack Starter">
  <meta name="twitter:description" content="React Server Components on Rails, with TanStack Router where client app state belongs.">
  <meta name="twitter:image" content="<%= social_image %>">
<% end %>
<%
  examples = [
    {
      eyebrow: "RSC",
      title: "React Server Components",
      body: "Rails routes the request and React on Rails Pro streams an async React Server Component tree. Only the client island ships browser JavaScript.",
      live: hello_server_path,
      live_label: "Open RSC demo",
      source: github_source_url("app/javascript/src/HelloServer/"),
      auth: false
    },
    {
      eyebrow: "App shell",
      title: "TanStack dashboard",
      body: "Authenticated Rails routes render a TanStack Router, Query, and Table dashboard through the React on Rails Pro Node renderer.",
      live: dashboard_path,
      live_label: "Open dashboard",
      source: github_source_url("app/javascript/src/Dashboard/ror_components/DashboardApp.tsx"),
      auth: true
    },
    {
      eyebrow: "Data",
      title: "Rails JSON API + Query",
      body: "Rails keeps persistence, validation, CSRF, filtering, sorting, and pagination. TanStack Query owns browser cache and invalidation.",
      live: projects_path,
      live_label: "Open projects",
      source: github_source_url("app/controllers/api/projects_controller.rb"),
      auth: true
    },
    {
      eyebrow: "Baseline",
      title: "Classic Rails CRUD",
      body: "Conventional Rails forms and controller patterns remain available for CRUD screens that do not need a client app shell.",
      live: classic_projects_path,
      live_label: "Open CRUD",
      source: github_source_url("app/controllers/projects_controller.rb"),
      auth: true
    },
    {
      eyebrow: "Accounts",
      title: "Auth + email verification",
      body: "Session auth, signup with email verification gating, password reset, mailers, and previews are already wired.",
      live: new_session_path,
      live_label: "Open sign in",
      source: github_source_url("app/controllers/registrations_controller.rb"),
      auth: false
    },
    {
      eyebrow: "Profile",
      title: "Settings",
      body: "Profile updates run from the TanStack dashboard while Rails still owns validation and the unverified-on-email-change gate.",
      live: settings_path,
      live_label: "Open settings",
      source: github_source_url("app/controllers/settings_controller.rb"),
      auth: true
    }
  ]

  prompts = [
    {
      title: "Get oriented",
      body: "Clone shakacode/react-on-rails-starter-tanstack and read AGENTS.md. Then explain how Rails routes /dashboard to DashboardController#show, how app/views/dashboard/show.html.erb renders DashboardApp, and how React on Rails Pro hands TanStack Router its SSR and hydration state."
    },
    {
      title: "Trace the RSC path",
      body: "Walk me through the React Server Components flow in this repo, from app/controllers/hello_server_controller.rb through app/views/hello_server/index.html.erb and app/javascript/src/HelloServer. Include the Webpack bridge status and the documented Rspack manifest limitation in SPIKE.md."
    },
    {
      title: "Add a feature",
      body: "In this repo, add a priority column to Project (enum: low, medium, high). Surface it as a sortable, URL-synced column in the TanStack table in DashboardApp.tsx, add server-side sorting in app/controllers/api/projects_controller.rb, and write request and Playwright specs following the existing patterns."
    },
    {
      title: "Add a new route",
      body: "Add an authenticated TanStack route at /reports following the dashboard-props-controller and tanstack-route reference patterns in AGENTS.md. Pass Rails-owned props through DashboardController and render a summary built with TanStack Query."
    }
  ]

  learn_links = [
    { label: "Why RSC on Rails", desc: "The launch thesis for keeping Rails as the app server.", href: github_source_url("docs/08-why-rsc-on-rails.md") },
    { label: "React on Rails + TanStack vs Inertia", desc: "Where the rendering boundary differs from page-props protocols.", href: github_source_url("docs/02-vs-inertia.md") },
    { label: "React Server Components", desc: "Architecture, rendering flow, and migration guidance.", href: "https://www.reactonrails.com/docs/pro/react-server-components/" },
    { label: "SSR tutorial", desc: "Render on the server, hydrate in the browser.", href: "https://www.reactonrails.com/docs/getting-started/tutorial/" },
    { label: "TanStack", desc: "Router, Query, and Table reference docs.", href: "https://tanstack.com/" },
    { label: "React on Rails Pro", desc: "Node renderer, RSC, and support paths.", href: "https://www.reactonrails.com/pro/" }
  ]
%>

<div class="min-h-screen bg-background text-foreground antialiased">
  <%= render "shared/site_header", show_section_nav: true %>

  <main>
    <%# ===================== HERO ===================== %>
    <section id="rsc" class="scroll-mt-16 border-b border-border">
      <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:py-20">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-3 py-1 text-xs font-medium text-muted-foreground">
            <span class="inline-block size-1.5 rounded-full bg-emerald-500"></span>
            Rails 8 · React 19 · React on Rails Pro · TanStack Router
          </span>
          <h1 class="mt-6 max-w-4xl text-balance text-4xl font-bold tracking-normal sm:text-5xl lg:text-6xl">
            React Server Components on Rails, without moving your app to a JS server.
          </h1>
          <p class="mt-6 max-w-2xl text-pretty text-lg text-muted-foreground">
            Keep Rails as the application server for auth, sessions, CSRF, validations,
            mailers, jobs, and Active Record. Add React on Rails Pro where server-rendered
            React and RSC need a Node rendering boundary. Use bare TanStack Router where
            the browser should own app navigation and URL state.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a href="<%= hello_server_path %>" class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/90">
              Open the RSC demo
            </a>
            <a href="<%= dashboard_path %>" class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-card px-6 text-sm font-medium shadow-sm transition-colors hover:bg-muted">
              Open the dashboard
            </a>
            <a href="<%= github_repo_url %>" target="_blank" rel="noreferrer noopener" class="inline-flex h-11 items-center justify-center rounded-md px-4 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground">
              Browse the source →
            </a>
          </div>

          <% if demo_credentials_hint_enabled? %>
            <p class="mt-4 text-sm text-muted-foreground">
              Demo login: <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-foreground"><%= demo_account_email %></code>
              / <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-foreground"><%= demo_account_password %></code>
            </p>
          <% end %>
        </div>

        <div class="rounded-lg border border-border bg-card shadow-sm">
          <div class="border-b border-border px-5 py-4">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Rendering boundary</p>
            <h2 class="mt-2 text-2xl font-semibold tracking-normal">One Rails app, three deliberate surfaces</h2>
          </div>
          <div class="grid gap-px bg-border">
            <div class="bg-card p-5">
              <p class="font-medium">Public RSC</p>
              <p class="mt-1 text-sm text-muted-foreground">Server components stream from Rails through React on Rails Pro; client islands stay small.</p>
            </div>
            <div class="bg-card p-5">
              <p class="font-medium">Authenticated TanStack</p>
              <p class="mt-1 text-sm text-muted-foreground">TanStack Router, Query, and Table run inside Rails-owned full-page routes.</p>
            </div>
            <div class="bg-card p-5">
              <p class="font-medium">Classic Rails</p>
              <p class="mt-1 text-sm text-muted-foreground">Plain Rails CRUD remains available where a client app shell would add no value.</p>
            </div>
          </div>
        </div>

        <ul class="lg:col-span-2 flex flex-wrap items-center justify-center gap-2">
          <% [
               { label: "React Server Components", accent: true },
               { label: "React on Rails Pro", accent: true },
               { label: "TanStack Router", accent: true },
               { label: "TanStack Query" },
               { label: "TanStack Table" },
               { label: "Rails 8" },
               { label: "PostgreSQL" },
               { label: "React 19" },
               { label: "TypeScript" },
               { label: "Tailwind v4" },
               { label: "shadcn/ui" },
               { label: "Rspack local default" },
               { label: "Webpack deploy bridge" }
             ].each do |chip| %>
            <li class="inline-flex items-center rounded-full border px-3 py-1 text-sm <%= chip[:accent] ? 'border-emerald-500/40 bg-emerald-500/10 font-medium text-emerald-700 dark:text-emerald-300' : 'border-border bg-card text-muted-foreground' %>">
              <%= chip[:label] %>
            </li>
          <% end %>
        </ul>
      </div>
    </section>

    <%# ===================== POSITIONING ===================== %>
    <section class="border-b border-border">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
        <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Why this stack</p>
            <h2 class="mt-3 text-3xl font-bold tracking-normal">React where it changes the product. Rails where it already wins.</h2>
            <p class="mt-4 text-muted-foreground">
              Inertia keeps Rails controllers close to pages by sending props to a client component tree.
              This starter chooses a different boundary: Rails remains the app server, while React on Rails
              Pro owns the server-rendered React and RSC boundary. That lets server components stay server-only
              instead of becoming another client page protocol.
            </p>
            <div class="mt-6 flex flex-wrap gap-2">
              <a href="<%= github_source_url('docs/08-why-rsc-on-rails.md') %>" target="_blank" rel="noreferrer noopener" class="inline-flex h-10 items-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/90">
                Read the RSC thesis
              </a>
              <a href="<%= github_source_url('docs/02-vs-inertia.md') %>" target="_blank" rel="noreferrer noopener" class="inline-flex h-10 items-center rounded-md border border-border bg-card px-4 text-sm font-medium shadow-sm transition-colors hover:bg-muted">
                Compare with Inertia
              </a>
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <article class="rounded-lg border border-border bg-card p-5 shadow-sm">
              <h3 class="font-semibold">No framework swap</h3>
              <p class="mt-2 text-sm text-muted-foreground">No TanStack Start, Vite migration, Hotwire layer, or file-based routing requirement.</p>
            </article>
            <article class="rounded-lg border border-border bg-card p-5 shadow-sm">
              <h3 class="font-semibold">Server-only code stays server-only</h3>
              <p class="mt-2 text-sm text-muted-foreground">RSC modules can await server data without shipping that implementation to the browser.</p>
            </article>
            <article class="rounded-lg border border-border bg-card p-5 shadow-sm">
              <h3 class="font-semibold">URL state belongs to TanStack</h3>
              <p class="mt-2 text-sm text-muted-foreground">The dashboard table keeps filter, sort, and pagination in shareable browser URLs.</p>
            </article>
            <article class="rounded-lg border border-border bg-card p-5 shadow-sm">
              <h3 class="font-semibold">Rails still owns the app</h3>
              <p class="mt-2 text-sm text-muted-foreground">Authentication, authorization boundaries, CSRF, model validation, mailers, and jobs stay in Rails.</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <%# ===================== EXAMPLE MAP ===================== %>
    <section id="examples" class="scroll-mt-16 border-b border-border">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
        <div class="max-w-2xl">
          <h2 class="text-3xl font-bold tracking-normal">Explore every surface</h2>
          <p class="mt-3 text-muted-foreground">
            Each surface this starter ships is one click away, with a direct link to its source on GitHub.
            Authenticated routes open the sign-in page first.
          </p>
        </div>

        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          <% examples.each do |example| %>
            <article class="flex flex-col rounded-lg border border-border bg-card p-5 shadow-sm transition-shadow hover:shadow-md">
              <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground"><%= example[:eyebrow] %></p>
              <h3 class="mt-2 text-lg font-semibold">
                <%= example[:title] %>
                <% if example[:auth] %><span class="ml-1 align-middle text-xs font-normal text-muted-foreground">(sign in)</span><% end %>
              </h3>
              <p class="mt-2 flex-1 text-sm text-muted-foreground"><%= example[:body] %></p>
              <div class="mt-4 flex items-center gap-3 text-sm font-medium">
                <% if example[:live] %>
                  <a href="<%= example[:live] %>" class="inline-flex items-center gap-1 text-foreground hover:underline">
                    <%= example[:live_label] %> →
                  </a>
                <% end %>
                <a href="<%= example[:source] %>" target="_blank" rel="noreferrer noopener" class="inline-flex items-center gap-1 text-muted-foreground hover:text-foreground">
                  Read source
                </a>
              </div>
            </article>
          <% end %>
        </div>
      </div>
    </section>

    <%# ===================== AI AGENTS ===================== %>
    <section id="agents" class="scroll-mt-16 border-b border-border bg-muted/20">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
        <div class="max-w-2xl">
          <h2 class="text-3xl font-bold tracking-normal">Made for your AI agent</h2>
          <p class="mt-3 text-muted-foreground">
            The repo ships an <a href="<%= github_source_url('AGENTS.md') %>" target="_blank" rel="noreferrer noopener" class="font-medium text-foreground underline-offset-4 hover:underline">AGENTS.md</a>
            playbook with reference patterns. Point Claude, Cursor, or Codex at the repo and paste one of these
            to learn, extend, or experiment.
          </p>
        </div>

        <div class="mt-10 grid gap-5 md:grid-cols-2">
          <% prompts.each do |prompt| %>
            <div data-prompt-card class="flex flex-col rounded-lg border border-border bg-card shadow-sm">
              <div class="flex items-center justify-between gap-2 border-b border-border px-5 py-3">
                <h3 class="font-semibold"><%= prompt[:title] %></h3>
                <button type="button" data-copy
                        class="inline-flex items-center gap-1.5 rounded-md border border-border px-2.5 py-1 text-xs font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground data-[copied]:border-emerald-500/40 data-[copied]:text-emerald-600">
                  <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                  <span data-copy-label>Copy</span>
                </button>
              </div>
              <pre data-prompt class="flex-1 whitespace-pre-wrap px-5 py-4 font-mono text-sm leading-relaxed text-muted-foreground"><%= prompt[:body] %></pre>
            </div>
          <% end %>
        </div>
      </div>
    </section>

    <%# ===================== LEARN ===================== %>
    <section id="learn" class="scroll-mt-16">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
        <div class="max-w-2xl">
          <h2 class="text-3xl font-bold tracking-normal">Choose what to learn next</h2>
          <p class="mt-3 text-muted-foreground">One link each. No detours.</p>
        </div>

        <div class="mt-10 grid gap-px overflow-hidden rounded-lg border border-border bg-border sm:grid-cols-2 lg:grid-cols-3">
          <% learn_links.each do |link| %>
            <a href="<%= link[:href] %>" target="_blank" rel="noreferrer noopener" class="group flex flex-col bg-card p-5 transition-colors hover:bg-muted/50">
              <span class="flex items-center justify-between font-medium">
                <%= link[:label] %>
                <span class="text-muted-foreground transition-transform group-hover:translate-x-0.5">→</span>
              </span>
              <span class="mt-1 text-sm text-muted-foreground"><%= link[:desc] %></span>
            </a>
          <% end %>
        </div>

        <p class="mt-8 rounded-lg border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-800 dark:text-amber-200">
          <strong>Honest status:</strong> Rspack remains the local default. The Webpack deploy bridge
          emits the RSC manifests today; the official relaunch stays anchored to upstream Rspack RSC
          support. See
          <a href="<%= github_source_url('SPIKE.md') %>" target="_blank" rel="noreferrer noopener" class="font-medium underline underline-offset-4">SPIKE.md</a>.
        </p>
      </div>
    </section>
  </main>

  <%= render "shared/site_footer" %>
</div>

<%= javascript_tag nonce: true do %>
  // Copy-to-clipboard for the AI prompt cards.
  document.addEventListener('click', function (event) {
    var button = event.target.closest('[data-copy]');
    if (!button) return;
    var card = button.closest('[data-prompt-card]');
    var pre = card && card.querySelector('[data-prompt]');
    if (!pre || !navigator.clipboard) return;
    navigator.clipboard.writeText(pre.textContent.trim()).then(function () {
      var label = button.querySelector('[data-copy-label]');
      if (!label) return;
      var previous = label.textContent;
      label.textContent = 'Copied!';
      button.setAttribute('data-copied', '');
      setTimeout(function () {
        label.textContent = previous;
        button.removeAttribute('data-copied');
      }, 1600);
    });
  });
<% end %>
