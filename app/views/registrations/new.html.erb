<main class="grid min-h-screen place-items-center bg-muted/40 px-4 py-10 text-foreground sm:px-6 lg:px-8">
  <section class="w-full max-w-md overflow-hidden rounded-lg border bg-card text-card-foreground shadow-sm">
    <div class="grid h-1 grid-cols-3" aria-hidden="true">
      <span class="bg-emerald-500"></span>
      <span class="bg-sky-500"></span>
      <span class="bg-amber-500"></span>
    </div>

    <header class="space-y-1.5 border-b px-6 py-5">
      <p class="text-sm font-medium text-muted-foreground">React on Rails Starter</p>
      <h1 class="text-2xl font-semibold leading-8">Create your account</h1>
      <p class="text-sm leading-6 text-muted-foreground">Start with a verified email so protected dashboard routes can stay server-gated.</p>
    </header>

    <div class="space-y-4 px-6 py-6">
      <% if @user.errors.any? %>
        <div class="rounded-md border border-destructive/50 bg-destructive/10 px-4 py-3 text-sm text-destructive" aria-live="polite">
          <p class="font-medium">Fix the highlighted fields and try again.</p>
          <ul class="mt-2 list-disc space-y-1 pl-5">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @user, url: registration_path, class: "space-y-4" do |form| %>
        <div class="space-y-2">
          <%= form.label :name, class: "text-sm font-medium leading-none" %>
          <%= form.text_field :name, required: true, autocomplete: "name", class: "h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-base text-foreground shadow-xs outline-none transition-[color,box-shadow] placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 sm:text-sm", aria: { describedby: ("name_errors" if @user.errors[:name].any?) } %>
          <% if @user.errors[:name].any? %>
            <span id="name_errors" class="text-sm text-muted-foreground"><%= @user.errors[:name].to_sentence %></span>
          <% end %>
        </div>

        <div class="space-y-2">
          <%= form.label :email_address, "Email", class: "text-sm font-medium leading-none" %>
          <%= form.email_field :email_address, required: true, autocomplete: "email", class: "h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-base text-foreground shadow-xs outline-none transition-[color,box-shadow] placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 sm:text-sm", aria: { describedby: ("email_errors" if @user.errors[:email_address].any?) } %>
          <% if @user.errors[:email_address].any? %>
            <span id="email_errors" class="text-sm text-muted-foreground"><%= @user.errors[:email_address].to_sentence %></span>
          <% end %>
        </div>

        <div class="space-y-2">
          <%= form.label :password, class: "text-sm font-medium leading-none" %>
          <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-base text-foreground shadow-xs outline-none transition-[color,box-shadow] placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 sm:text-sm" %>
        </div>

        <div class="space-y-2">
          <%= form.label :password_confirmation, "Confirm password", class: "text-sm font-medium leading-none" %>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-base text-foreground shadow-xs outline-none transition-[color,box-shadow] placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 sm:text-sm" %>
        </div>

        <%= form.submit "Create account", class: "inline-flex h-10 w-full items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-xs transition-colors hover:bg-primary/90 focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50" %>
      <% end %>
    </div>

    <footer class="flex flex-wrap items-center gap-2 border-t px-6 py-4 text-sm text-muted-foreground">
      <span>Already have an account?</span>
      <%= link_to "Sign in", new_session_path, class: "font-medium text-foreground underline-offset-4 hover:underline" %>
    </footer>
  </section>
</main>
