<% dashboard_fallback = capture do %>
  <section class="tanstack-noscript-shell" aria-label="Dashboard">
    <h1>Dashboard</h1>
    <p>Your email is verified.</p>
    <nav aria-label="Dashboard fallback navigation">
      <%= link_to "Projects", projects_path %>
      <%= link_to "Classic Rails CRUD", classic_projects_path %>
      <%= link_to "Settings", settings_path %>
    </nav>
  </section>
<% end %>

<% if Rails.env.test? %>
  <%= dashboard_fallback %>
<% else %>
  <noscript><%= dashboard_fallback %></noscript>
<% end %>

<!-- TANSTACK_SSR_SHELL: DashboardApp is prerendered by React on Rails Pro and hydrated by TanStack Router. -->
<%= react_component("DashboardApp", id: "DashboardApp", props: @dashboard_props, prerender: !Rails.env.test?) %>
