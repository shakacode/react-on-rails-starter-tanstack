# Procfile for development with production assets.
# Uses production-optimized, precompiled assets with the development Rails environment.

rails: bundle exec rails s -p ${PORT:-3001}
worker: bin/jobs
renderer: RAILS_ENV=${RAILS_ENV:-development} RENDERER_LOG_LEVEL=${RENDERER_LOG_LEVEL:-info} RENDERER_PORT=${RENDERER_PORT:-3800} node client/node-renderer.js
