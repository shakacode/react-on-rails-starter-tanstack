# Development process file. `bin/dev` reads this through the React on Rails
# process manager.
# REFERENCE PATTERN: rspack-live-reload-procfile — see AGENTS.md
web: bundle exec rails s -p ${PORT:-3000}
rspack: bin/shakapacker-dev-server
server-bundle: SERVER_BUNDLE_ONLY=true bin/shakapacker-watch --watch
worker: bin/jobs
renderer: RENDERER_LOG_LEVEL=${RENDERER_LOG_LEVEL:-debug} RENDERER_PORT=${RENDERER_PORT:-3800} node client/node-renderer.js
rsc-bundle: RSC_BUNDLE_ONLY=true bin/shakapacker-watch --watch
